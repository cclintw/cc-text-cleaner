#: cc-text-cleaner.php:187
msgid "Help"
msgstr ""

#: cc-text-cleaner.php:195
msgid "This tool performs the following cleanup tasks, then converts the result into a plain text file (.txt) for direct download. No files are stored on this website. The maximum accepted file size is 5MB. For more advanced cleanup options, please use the site’s other tool."
msgstr ""

#: cc-text-cleaner.php:202
msgid "1. Remove half-width spaces except those between English letters or symbols."
msgstr ""

#: cc-text-cleaner.php:203
msgid "2. Remove all control characters except line breaks."
msgstr ""

#: cc-text-cleaner.php:204
msgid "3. Replace invalid characters or garbled text with ■."
msgstr ""

#: cc-text-cleaner.php:205
msgid "4. Replace HTML heading (<h1> - <h6>) and paragraph (<p>) tags with line breaks."
msgstr ""

#: cc-text-cleaner.php:206
msgid "5. Remove HTML, XML, CSS, Script, and other syntax or tags."
msgstr ""

#: cc-text-cleaner.php:207
msgid "6. Convert some vertical full-width punctuation marks to horizontal punctuation marks (﹃ ﹄ ﹁ ﹂ ︿ ﹀ ︽ ︾)."
msgstr ""

